<Window x:Class="MenoNaptar.StatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MenoNaptar"
        mc:Ignorable="d"
        Title="Statisztikák" Height="450" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.7*" />
            <RowDefinition />
            <RowDefinition Height="0.7*" />
            <RowDefinition />
            <RowDefinition Height="0.7*" />
            <RowDefinition />
            <RowDefinition Height="0.7*" />
            <RowDefinition />
            <RowDefinition Height="0.7*" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Legtöbbet lefoglalt szoba" VerticalAlignment="Bottom" Margin="10px 5px" FontWeight="Bold" />
        <TextBlock Grid.Row="1" x:Name="TBlegFogSzoba" VerticalAlignment="Top" Margin="10px 5px" FontSize="20px" />

        <TextBlock Grid.Row="2" Text="Leghosszabb foglalás" VerticalAlignment="Bottom" Margin="10px 5px" FontWeight="Bold" />
        <TextBlock Grid.Row="3" x:Name="TBlegFog" VerticalAlignment="Top" Margin="10px 5px" FontSize="20px" />

        <TextBlock Grid.Row="4" Text="Foglalás átlagos hossza" VerticalAlignment="Bottom" Margin="10px 5px" FontWeight="Bold" />
        <TextBlock Grid.Row="5" x:Name="TBatlFogl" VerticalAlignment="Top" Margin="10px 5px" FontSize="20px" />

        <TextBlock Grid.Row="6" Text="Legtöbbet foglaló" VerticalAlignment="Bottom" Margin="10px 5px" FontWeight="Bold" />
        <TextBlock Grid.Row="7" x:Name="TBlegFogSzem" VerticalAlignment="Top" Margin="10px 5px" FontSize="20px" />

        <TextBlock Grid.Row="8" Text="Személyek átlagos száma" VerticalAlignment="Bottom" Margin="10px 5px" FontWeight="Bold" />
        <TextBlock Grid.Row="9" x:Name="TBatlSzem" VerticalAlignment="Top" Margin="10px 5px" FontSize="20px" />
    </Grid>
</Window>
